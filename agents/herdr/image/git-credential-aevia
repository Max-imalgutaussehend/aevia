#!/bin/sh
# git credential helper: reads "https://user:token@host" lines from a mounted secret (read-only), answers `get` only.
[ "$1" = get ] || exit 0
FILE=${AEVIA_GIT_CREDENTIALS:-/etc/herdr-git/credentials}
[ -r "$FILE" ] || exit 0
host=; while IFS='=' read -r k v; do [ "$k" = host ] && host=$v; done
[ -n "$host" ] || exit 0
line=$(grep -m1 "@$host\$" "$FILE" 2>/dev/null) || exit 0
rest=${line#https://}; userpass=${rest%@*}
printf 'username=%s\npassword=%s\n' "${userpass%%:*}" "${userpass#*:}"
