# Copy to production.tfvars (gitignored). Secrets: pass via SOPS or TF_VAR_*, not here.
domain                = "example.com"
cloudflare_account_id = ""
cloudflare_zone_id    = ""
ssh_public_key        = "ssh-ed25519 AAAA... life-server"   # ~/.ssh/life-server.pub
ssh_allowed_cidrs     = []                                    # ["<your-ip>/32"]
# hcloud_token, cloudflare_api_token, tunnel_secret -> TF_VAR_*
